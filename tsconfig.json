{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "noEmit": false,
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "webpack.config.ts",
    "plugins/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}